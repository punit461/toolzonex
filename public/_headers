# Cloudflare Pages reads this file from the root of the published output (out/,
# since Next.js copies everything in public/ there during static export) and
# applies these headers to matching responses.
#
# next.config.ts already defines this same header set via the `headers()` config
# function, but that function has no effect under `output: "export"` (static
# export produces plain files with no Node server to apply it) — which is why
# the live site was previously shipping none of these. This file is the actual
# enforcement point once hosted on Cloudflare Pages.
#
# The CSP ships as Report-Only first: it does not block anything yet, only logs
# violations to the browser console (Chrome DevTools > Console, or the "Issues"
# tab). Load the homepage, a calculator page, and a page with AdSense + GA4
# active, confirm zero CSP violation warnings, then rename the directive below
# from Content-Security-Policy-Report-Only to Content-Security-Policy to enforce
# it. Do not flip it to enforcing without that check — a wrong CSP silently
# breaks ads/analytics rather than erroring loudly.
#
# static.cloudflareinsights.com / cloudflareinsights.com: Cloudflare Web
# Analytics beacon (auto-injected at the edge since this zone is proxied, or
# added manually — either way it needs these two hosts allowed).
# challenges.cloudflare.com: Turnstile widget on the contact form (script +
# the iframe it renders the challenge in).
#
# The AdSense hosts below were added 2026-09-13 after a Lighthouse run surfaced
# the report-only violations this file was staged to collect. AdSense does not
# stop at pagead2/doubleclick — a served ad also pulls in:
#   ep1/ep2.adtrafficquality.google  Ad Traffic Quality (sodar2.js + an iframe
#                                    + a /getconfig/sodar XHR)
#   fundingchoicesmessages.google.com  Privacy & messaging / consent prompt
#   www.google.com                   framed by the ad stack
#   adservice.google.com, partner.googleadservices.com,
#   www.googletagservices.com        ad serving + tag delivery
#   csi.gstatic.com                  ad latency beacons
# All were violation sources in that run, so leaving them out would break ads
# the moment this is enforced -- which is precisely the failure the staging
# comment above warns about.

/*
  X-DNS-Prefetch-Control: on
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://pagead2.googlesyndication.com https://www.googletagmanager.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://static.cloudflareinsights.com https://challenges.cloudflare.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://fundingchoicesmessages.google.com https://adservice.google.com https://partner.googleadservices.com https://www.googletagservices.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://cloudflareinsights.com https://script.google.com https://script.googleusercontent.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://fundingchoicesmessages.google.com https://csi.gstatic.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://challenges.cloudflare.com https://www.google.com https://ep1.adtrafficquality.google https://ep2.adtrafficquality.google https://fundingchoicesmessages.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'
