NEXT_PUBLIC_CONTACT_SHEET_URL=

# Canonical site URL, no trailing slash. Used to build absolute URLs in
# metadata, canonical tags, JSON-LD, and Open Graph/Twitter images.
# The deploy workflow sets this to https://toolzonex.com directly (it's
# not sensitive, so it isn't a secret) — set it here too for local dev.
NEXT_PUBLIC_SITE_URL=https://toolzonex.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Create a GA4 property at analytics.google.com, then add this as a
# repo secret (Settings > Secrets and variables > Actions) so the
# deploy workflow can inject it at build time. Leave blank to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=